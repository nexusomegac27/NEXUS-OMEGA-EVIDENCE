    ],
    "Falsifier": [
      "id",
      "target_claim_id",
      "negative_design",
      "expected_failure",
      "observed_failure_or_not_run"
    ],
    "CorrectionCandidate": [
      "id",
      "original_code_sha256",
      "candidate_code_sha256",
      "exact_diff",
      "original_red_receipt_id",
      "candidate_green_receipt_id",
      "independent_replay_status"
    ],
    "Adjudication": [
      "id",
      "authority",
      "scope_verdict",
      "original_source_scope",
      "blockers",
      "separate_gate_status"
    ],
    "KnowledgeDelta": [
      "id",
      "parent_event_id",
      "event_kind",
      "affected_claim_ids",
