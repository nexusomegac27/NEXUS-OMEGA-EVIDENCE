    ]
  },
  "relation_types": [
    "WAS_DERIVED_FROM",
    "USED",
    "GENERATED_BY",
    "HYPOTHESIZES",
    "TESTS",
    "CHALLENGES",
    "REPRODUCES",
    "REFUTES",
    "CORRECTS",
    "REQUIRES",
    "BLOCKED_BY",
    "AUTHORIZED_BY",
    "SUPERSEDES_SCOPE_ONLY",
    "NO_INDEPENDENT_ORIGIN"
  ],
  "states": [
    "DISCOVERY_CANDIDATE",
    "SOURCE_READ_C1",
    "Q4_ORIGINAL_BYTE_RECEIPT_C1",
    "PREREGISTERED_DESIGN_C1",
    "LOCAL_REPLAY_REPORTED_C1",
    "LOCAL_REPLAY_VERIFIED_C1",
    "INDEPENDENT_Q5_REPLAY_C1",
    "AXIOM_ADJUDICATED_C1",
    "SOURCE_GAP",
    "NOT_RUN",
    "CONTRADICTED",
    "QUARANTINED",
    "HOLD",
    "ABSTAIN"
  ],
  "rules": [
    {
      "id": "R-01",
      "if": "source_q_Q4",
      "require": "actual_original_bytes_and_sha256_or_private_Q4_receipt",
      "on_fail": "HOLD"
    },
    {
      "id": "R-02",
      "if": "result_is_PASS",
      "require": "passed_equals_total_and_exit_code_equals_0",
      "on_fail": "REJECTED"
    },
    {
      "id": "R-03",
      "if": "numeric_count_claim",
      "require": "nonnegative_counts_and_sum_not_exceed_declared_population",
      "on_fail": "REJECTED"
    },
    {
      "id": "R-04",
      "if": "elapsed_duration_claim",
      "require": "monotonic_nonnegative_elapsed",
      "on_fail": "REJECTED"
    },
    {
      "id": "R-05",
      "if": "canonical_lane_credit",
      "require": "exact_canonical_lane_object_identity_not_external_alias",
      "on_fail": "REJECTED"
    },
    {
      "id": "R-06",
      "if": "actor_registered_quorum_credit",
      "require": "operator_authenticated_root_and_distinct_actor_and_independent_data_model_lineage",
      "on_fail": "HOLD"
    },
    {
      "id": "R-07",
      "if": "dual_smartphone_empirical_gain_claim",
      "require": "physically_two_simultaneous_phones_and_valid_independent_reference_and_grouped_holdout_equal_cost",
      "on_fail": "REJECTED"
    },
    {
      "id": "R-08",
      "if": "self_learning_autonomy_claim",
      "require": "separate_user_operator_authorization_and_executable_scoped_runtime_replay",
      "on_fail": "HOLD"
    },
    {
      "id": "R-09",
      "if": "source_code_correction",
      "require": "original_sha_preserved_candidate_sha_new_and_before_after_receipts_and_no_retroactive_state_mutation",
      "on_fail": "HOLD"
    },
    {
      "id": "R-10",
      "if": "holdout_eval",
      "require": "pre_frozen_evaluator_and_no_test_label_exposure_or_overlap",
      "on_fail": "HOLD"
    },
    {
      "id": "R-11",
      "if": "final_archive_claim",
      "require": "outer_sha_current_and_inner_receipt_same_version_and_manifest_coverage",
      "on_fail": "HOLD"
    },
    {
      "id": "R-12",
      "if": "public_github_write",
      "require": "only_public_safe_metadata_no_raw_human_biometric_credentials_or_unregistered_write",
      "on_fail": "REJECTED"
    }
  ],
