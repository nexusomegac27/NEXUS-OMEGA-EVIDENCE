{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nexusomegac27/NEXUS-OMEGA-EVIDENCE/research/r31/open-innovation-independent-expert-research-20261117/03_EXPERT_RETURN_AND_ARTIFACT_CONTRACT.json",
  "title": "NEXUS OMEGA R31 — Independent external research and innovation terminal return",
  "description": "Contract ONLY; not evidence of tests, execution, sources, authenticity or deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object",
    "parent_order",
    "date_utc",
    "reviewer",
    "independence",
    "stage_0",
    "mandates",
    "primary_sources",
    "architectures",
    "innovations",
    "falsification",
    "tests",
    "key_risks",
    "verdict",
    "governance"
  ],
  "properties": {
    "object": {
      "type": "string",
      "pattern": "^NEXUS_OMEGA_EXTERNAL_R31_OPEN_INNOVATION_RETURN_"
    },
    "parent_order": {
      "const": "NEXUS_OMEGA_AXIOM_R31_OPEN_INNOVATION_INDEPENDENT_VERIFICATION_EXPERT_MAXI_ORDER_20261117_R0"
    },
    "date_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "required": [
        "id_self_declared",
        "model_or_expertise",
        "tools_actually_used",
        "source_access"
      ],
      "properties": {
        "id_self_declared": {
          "type": "string",
          "minLength": 1
        },
        "model_or_expertise": {
          "type": "string"
        },
        "tools_actually_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_access": {
          "enum": [
            "PUBLIC_ONLY",
            "AUTHORIZED_PRIVATE_READ_ONLY",
            "NONE",
            "PARTIAL"
          ]
        },
        "conflicts_of_interest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "required": [
        "identity_authentication",
        "previous_exposure",
        "reviewer_reports_seen_before_first_hypothesis"
      ],
      "properties": {
        "identity_authentication": {
          "enum": [
            "SELF_REPORTED_ONLY",
            "INDEPENDENT_AUTHENTICATION_OBSERVED",
            "UNKNOWN"
          ]
        },
        "previous_exposure": {
          "enum": [
            "NONE_KNOWN",
            "PRIOR_R31_CONTEXT_KNOWN",
            "KNOWN_OTHER_EXPERT_WORK",
            "OTHER_DISCLOSED"
          ]
        },
        "reviewer_reports_seen_before_first_hypothesis": {
          "type": "boolean"
        },
        "disclosure": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stage_0": {
      "type": "object",
      "required": [
        "state",
        "first_hypothesis",
        "independent_architecture",
        "strongest_self_falsifier"
      ],
      "properties": {
        "state": {
          "enum": [
            "ORIGINAL_BEFORE_OTHER_SOURCE_READ",
            "PREEXPOSED_DISCLOSED",
            "NOT_COMPLETED"
          ]
        },
        "first_hypothesis": {
          "type": "string"
        },
        "independent_architecture": {
          "type": "string"
        },
        "strongest_self_falsifier": {
          "type": "string"
        },
        "original_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "timestamp_of_fixation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mandates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "E01",
          "E02",
          "E03",
          "E04",
          "E05",
          "E06",
          "E07",
          "E08",
          "E09",
          "E10",
          "E11",
          "E12",
          "E99_OPEN_INNOVATION"
        ]
      },
      "uniqueItems": true
    },
    "primary_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "uri",
          "read_status",
          "claim_supported"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "read_status": {
            "enum": [
              "DIRECTLY_READ",
              "PARTIALLY_READ",
              "NOT_READ",
              "ACCESS_DENIED"
            ]
          },
          "version_or_date": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "claim_supported": {
            "type": "string"
          },
          "disconfirming_context": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "architecture_id",
          "description",
          "assumptions",
          "strongest_counterexample",
          "dependencies",
          "deployment_required"
        ],
        "properties": {
          "architecture_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strongest_counterexample": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license_risk": {
            "type": "string"
          },
          "rollback_and_offline_fallback": {
            "type": "string"
          },
          "deployment_required": {
            "type": "boolean"
          },
          "comparison": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "innovations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "innovation_id",
          "title",
          "innovation_type",
          "problem",
          "claim_scope",
          "claimed_novelty_limit",
          "refutation_condition",
          "artifact_paths",
          "license",
          "dependency_risk",
          "privacy_class",
          "execution_evidence_class"
        ],
        "properties": {
          "innovation_id": {
            "type": "string",
            "pattern": "^INV-R31-"
          },
          "title": {
            "type": "string"
          },
          "innovation_type": {
            "enum": [
              "NEW_REFERENCE_ORACLE",
              "FORMAL_MODEL",
              "NEW_SYSTEM_ARCHITECTURE",
              "NEW_EXPERIMENT",
              "NEW_PROVENANCE_ARTIFACT",
              "NEW_THREAT_OR_RISK_MODEL",
              "NEW_POLICY_OR_LICENSE_GUARD",
              "NEW_OPERATIONAL_DESIGN",
              "NEGATIVE_INNOVATION_NO_NEW_MODULE",
              "OTHER"
            ]
          },
          "problem": {
            "type": "string"
          },
          "claim_scope": {
            "const": "C1_DESCRIPTIVE_ONLY"
          },
          "claimed_novelty_limit": {
            "type": "string"
          },
          "refutation_condition": {
            "type": "string",
            "minLength": 1
          },
          "artifact_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "string"
          },
          "dependency_risk": {
            "type": "string"
          },
          "privacy_class": {
            "enum": [
              "PUBLIC_SAFE_SYNTHETIC",
              "PRIVATE_NOT_TRANSFERRED",
              "LICENSE_UNRESOLVED",
              "OTHER_BOUND"
            ]
          },
          "execution_evidence_class": {
            "enum": [
              "DESIGN_ONLY",
              "SOURCE_STATIC_REVIEW",
              "EXTERNAL_SYNTHETIC_SELF_RUN",
              "NOT_RUN"
            ]
          },
          "implementation_handoff_readiness": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "byte_length",
          "sha256",
          "mime_or_type",
          "origin",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "mime_or_type": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "REVIEWER_CREATED",
              "EXTERNAL_SOURCE_PINNED",
              "DERIVED"
            ]
          },
          "license": {
            "type": "string"
          },
          "synthetic_only": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "falsification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "hypothesis",
          "stimulus",
          "independent_oracle",
          "test_status",
          "claim_effect"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "stimulus": {
            "type": "string"
          },
          "independent_oracle": {
            "type": "string"
          },
          "test_status": {
            "enum": [
              "DESIGN_ONLY",
              "NOT_RUN",
              "SOURCE_STATIC_REVIEW",
              "EXTERNAL_SYNTHETIC_SELF_RUN",
              "FAIL_OBSERVED_SYNTHETIC",
              "PASS_OBSERVED_SYNTHETIC"
            ]
          },
          "claim_effect": {
            "type": "string"
          },
          "preregistration_status": {
            "enum": [
              "HISTORIC_KNOWN",
              "PREDECLARED_BEFORE_OWN_TEST",
              "POST_HOC",
              "OTHER_DISCLOSED"
            ]
          },
          "test_artifact_path": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "self_run_synthetic",
        "nexus_runtime",
        "hostinger_F01_F20",
        "all_executed_ids"
      ],
      "properties": {
        "self_run_synthetic": {
          "type": "integer",
          "minimum": 0
        },
        "nexus_runtime": {
          "const": 0
        },
        "hostinger_F01_F20": {
          "const": 0
        },
        "all_executed_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "not_run_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "key_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "SUPPORTS_SCOPED_DESIGN_WITH_CAVEATS",
        "REJECTS_EXISTING_DESIGN",
        "HOLD_MATERIAL_GAP",
        "INCONCLUSIVE",
        "INDEPENDENT_ALTERNATIVE_PREFERRED"
      ]
    },
    "preferred_architecture_id": {
      "type": "string"
    },
    "independent_self_criticism": {
      "type": "string"
    },
    "one_next_decision": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "required": [
        "claim_ceiling",
        "claim_promotion",
        "nexus_write",
        "hostinger_write",
        "merge",
        "bodytwin_validated",
        "r30",
        "r32",
        "auto_start"
      ],
      "properties": {
        "claim_ceiling": {
          "const": "C1_DESCRIPTIVE_ONLY"
        },
        "claim_promotion": {
          "const": false
        },
        "nexus_write": {
          "const": false
        },
        "hostinger_write": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "bodytwin_validated": {
          "const": false
        },
        "r30": {
          "const": "CLOSED_C1_PRESERVED"
        },
        "r32": {
          "const": false
        },
        "auto_start": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
