{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusomegac27.github.io/NEXUS-OMEGA-EVIDENCE/schema/A83_handoff_envelope_v1.schema.json",
  "title": "NEXUS OMEGA A83 Ledger-Bound Handoff Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "object_id", "parent_record_sha256",
    "sender_role", "recipient_role", "actor_role", "claim_ceiling",
    "claim_promotion", "integration_authority", "observability_class",
    "receipt_assurance", "scientific_relevance_class", "transport_class",
    "payload_sha256", "payload_bytes", "sunset_months", "auto_execute",
    "network_write", "created_at_utc", "caveats"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$"},
    "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "parent_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sender_role": {"enum": ["OPERATOR", "AXIOM", "CURSOR_PRAXIS", "EXTERNAL_AGENT", "VALIDATOR", "COPILOT_CONTEXT_CONSUMER"]},
    "recipient_role": {"enum": ["OPERATOR", "AXIOM", "CURSOR_PRAXIS", "EXTERNAL_AGENT", "VALIDATOR", "COPILOT_CONTEXT_CONSUMER"]},
    "actor_role": {"enum": ["PRODUCER", "VALIDATOR", "IMPLEMENTER", "OPERATOR", "CONTEXT_CONSUMER"]},
    "claim_ceiling": {"const": "C1"},
    "claim_promotion": {"const": false},
    "integration_authority": {"const": "NONE"},
    "observability_class": {"enum": ["OBS0_UNOBSERVABLE", "OBS1_PROVIDER_AGGREGATE", "OBS2_PROVIDER_EVENT", "OBS3_MEDIATED_EVENT", "OBS4_MUTUAL_RECEIPT"]},
    "receipt_assurance": {"enum": ["RA0_NONE", "RA1_SELF_ASSERTED", "RA2_MUTUAL_BYTE_BOUND", "RA3_AUTHENTICATED_PLATFORM", "RA4_SIGNED_OR_TIMESTAMPED", "RA5_EXTERNAL_TRANSPARENCY_WITNESS"]},
    "scientific_relevance_class": {"enum": ["SR0_OPERATIONAL", "SR1_PROVENANCE_SUPPORT", "SR2_PROCESS_EVENT", "SR3_CLAIM_EVIDENCE", "SR4_GOVERNANCE_VALIDATION", "SR5_SECURITY_INTEGRITY"]},
    "transport_class": {"enum": ["CHAT_UI", "API", "GITHUB", "GIT", "FILE_UPLOAD", "OPERATOR_COPY_PASTE", "CONTROLLED_GATEWAY", "OTHER"]},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_bytes": {"type": "integer", "minimum": 0},
    "sunset_months": {"type": "integer", "minimum": 12, "maximum": 120},
    "auto_execute": {"const": false},
    "network_write": {"const": false},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "caveats": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
