{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusomegac27.github.io/NEXUS-OMEGA-EVIDENCE/schema/artifact-rollout-plan-v1.schema.json",
  "title": "NEXUS OMEGA artifact rollout preparation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "rollout_id",
    "stage",
    "object_id",
    "state",
    "created_at_utc",
    "claim_ceiling",
    "source",
    "github_observations",
    "source_refs",
    "rollout_policy",
    "rollout_phases",
    "authority_gates",
    "token_continuation",
    "relay",
    "caveats"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol": {"const": "PR15_ARTIFACT_HANDOFF_ROLLOUT_PREP_V1"},
    "rollout_id": {"type": "string", "pattern": "^NEXUS_RO_[0-9]{8}T[0-9]{6}Z_[a-z0-9][a-z0-9_-]{0,79}_R[0-9]+$"},
    "stage": {"const": "PREPARE_ONLY"},
    "object_id": {"type": "string", "minLength": 8},
    "state": {"const": "PREPARED_SEPARATE_C1"},
    "created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "claim_ceiling": {"enum": ["C0_EXPLORATORY", "C1_DESCRIPTIVE", "C0_EXPLORATORY_C1_DESCRIPTIVE", "C1"]},
    "source": {"type": "object"},
    "github_observations": {"type": "object"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "rollout_policy": {"type": "object"},
    "rollout_phases": {"type": "array", "minItems": 1},
    "authority_gates": {"type": "array"},
    "token_continuation": {"type": "object"},
    "relay": {"type": "object"},
    "caveats": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
