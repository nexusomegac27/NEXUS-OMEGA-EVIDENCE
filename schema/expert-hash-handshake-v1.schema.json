{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nexusomegac27/NEXUS-OMEGA-EVIDENCE/blob/main/schema/expert-hash-handshake-v1.schema.json",
  "title": "NEXUS_OPERATOR_AXIOM external researcher detached hash handshake candidate V1",
  "description": "Untrusted sender manifest; schema conformity and hash equality do not authenticate GitHub actor or prove science.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object",
    "recipient",
    "order_object",
    "order_sha256",
    "order_bytes",
    "repo",
    "transport_class",
    "sender_role",
    "github_actor",
    "predecessor",
    "claim_ceiling",
    "runtime",
    "receiver_ack",
    "children"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "object": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "recipient": {
      "const": "NEXUS_OPERATOR_AXIOM"
    },
    "order_object": {
      "type": "string",
      "minLength": 8
    },
    "order_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "order_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "repo": {
      "const": "nexusomegac27/NEXUS-OMEGA-EVIDENCE"
    },
    "transport_class": {
      "enum": [
        "REGISTERED_ACTOR_PR",
        "OPERATOR_TO_AXIOM_BRIDGE"
      ]
    },
    "sender_role": {
      "enum": [
        "GROK",
        "PERPLEXITY",
        "MISTRAL_VIBE",
        "QWEN",
        "GEMINI",
        "MANUS",
        "DEEPSEEK"
      ]
    },
    "github_actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pr_url": {
      "type": "string",
      "maxLength": 2048
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|NOT_ESTABLISHED)$"
    },
    "predecessor": {
      "type": "string",
      "minLength": 8
    },
    "claim_ceiling": {
      "const": "C1_DESCRIPTIVE_ONLY"
    },
    "runtime": {
      "const": "NOT_AUTHORIZED"
    },
    "receiver_ack": {
      "const": "PENDING_AXIOM_INDEPENDENT_REHASH"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "git_blob_sha1"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "git_blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  }
}
