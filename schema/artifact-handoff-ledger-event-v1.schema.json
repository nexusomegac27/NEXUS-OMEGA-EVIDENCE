{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusomegac27.github.io/NEXUS-OMEGA-EVIDENCE/schema/artifact-handoff-ledger-event-v1.schema.json",
  "title": "NEXUS OMEGA Artifact Handoff Ledger Event v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["event"],
  "properties": {
    "event": {"type": "string", "minLength": 1},
    "type": {"type": "string"},
    "id": {"type": "string"},
    "path": {"type": "string"},
    "bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ts": {"type": "string"},
    "detail": {"type": "string"},
    "preserved": {"type": "boolean"}
  }
}
