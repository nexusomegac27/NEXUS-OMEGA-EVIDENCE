{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexus/research-pipeline-package-v1.schema.json",
  "title": "NEXUS OMEGA Research Pipeline Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "created_at_utc", "updated_at_utc",
    "phase", "strand", "title", "objective", "state", "owners",
    "producer", "intended_processor", "claim_ceiling", "claim_promotion",
    "integration_authority", "predecessor_packages", "research_questions",
    "item_count", "snapshot_count", "latest_snapshot", "uncertainty", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^NEXUS_RP_[0-9]{8}T[0-9]{6}Z_[a-z0-9][a-z0-9_-]{0,63}_[0-9a-f]{8}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "minLength": 1},
    "strand": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "state": {"enum": ["INTAKE", "ACTIVE", "READY_FOR_CURSOR", "CURSOR_PROCESSING", "PROCESSED", "BLOCKED", "SUPERSEDED", "REOPENED"]},
    "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "producer": {"type": "string", "minLength": 1},
    "intended_processor": {"type": "string", "minLength": 1},
    "claim_ceiling": {"const": "C1"},
    "claim_promotion": {"const": false},
    "integration_authority": {"const": "NONE"},
    "predecessor_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "research_questions": {"type": "array", "items": {"type": "string"}},
    "item_count": {"type": "integer", "minimum": 0},
    "snapshot_count": {"type": "integer", "minimum": 0},
    "latest_snapshot": {"type": ["string", "null"]},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
